# Environment — DO NOT commit this file. Copy to .env and fill in values.

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ajj:ajj@localhost:5432/ajjforms

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────
PORT=8090
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of host domains allowed to submit forms
# Example: https://yoursite.com,https://staging.yoursite.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="AJJ Forms <noreply@example.com>"

# ─── File Storage (S3-compatible) ────────────────────────────────────────
# Leave blank to use local disk storage in development
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ajj-form-uploads
S3_REGION=us-east-1

# ─── CAPTCHA ─────────────────────────────────────────────────────────────
# Provide one or both; which is used is configured per-form
RECAPTCHA_SECRET=
HCAPTCHA_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────────
# Obtain all three values from https://dashboard.stripe.com

# Secret key — used server-side only (Node.js API). NEVER expose in browser code.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# Publishable key — safe to expose in browser bundles (Stripe Elements / SDK).
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# Webhook signing secret — from Dashboard → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Payment Link — a pre-built Stripe-hosted checkout page.
# Create one at https://dashboard.stripe.com/payment-links
# Use this when you do NOT need a custom checkout UI (zero backend required).
STRIPE_PAYMENT_LINK=https://buy.stripe.com/REPLACE_WITH_YOUR_PAYMENT_LINK
